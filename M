<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>Super Mario Prototype</title>
    <style>
        body { margin: 0; background: #111; display: flex; justify-content: center; align-items: center; height: 100vh; color: white; font-family: Arial; }
        canvas { border: 4px solid #fff; background: #5c94fc; }
    </style>
</head>
<body>
    <div style="text-align: center;">
        <h2>ماريو الصغير</h2>
        <canvas id="gameCanvas" width="800" height="400"></canvas>
        <p>التحكم: الأسهم للحركة | المسافة (Space) للقفز</p>
    </div>
<script>
const canvas = document.getElementById('gameCanvas'); const ctx = canvas.getContext('2d');
const gravity = 0.5; let score = 0; let gameOver = false;
const player = { x: 50, y: 300, width: 30, height: 40, velX: 0, velY: 0, speed: 4, jumpForce: 11, grounded: false, color: '#e21b1b' };
const keys = {};
const platforms = [ { x: 0, y: 360, width: 1200, height: 40, color: '#fcb47c' }, { x: 200, y: 260, width: 90, height: 20, color: '#fcb47c' }, { x: 350, y: 200, width: 120, height: 20, color: '#fcb47c' }, { x: 550, y: 260, width: 90, height: 20, color: '#fcb47c' } ];
let coins = [ { x: 230, y: 220, width: 15, height: 15, collected: false }, { x: 400, y: 160, width: 15, height: 15, collected: false }, { x: 580, y: 220, width: 15, height: 15, collected: false } ];
let enemies = [ { x: 400, y: 330, width: 30, height: 30, speed: -1.5, color: '#944400', alive: true }, { x: 700, y: 330, width: 30, height: 30, speed: -2, color: '#944400', alive: true } ];
document.addEventListener('keydown', (e) => { keys[e.code] = true; }); document.addEventListener('keyup', (e) => { keys[e.code] = false; });
function checkCollision(r1, r2) { return r1.x < r2.x + r2.width && r1.x + r1.width > r2.x && r1.y < r2.y + r2.height && r1.y + r1.height > r2.y; }
function update() {
    if (gameOver) return;
    if (keys['ArrowRight'] || keys['KeyD']) { if (player.velX < player.speed) player.velX++; }
    if (keys['ArrowLeft'] || keys['KeyA']) { if (player.velX > -player.speed) player.velX--; }
    if ((keys['ArrowUp'] || keys['Space']) && player.grounded) { player.velY = -player.jumpForce; player.grounded = false; }
    player.velX *= 0.85; player.velY += gravity; player.grounded = false;
    platforms.forEach(p => { if (player.x < p.x + p.width && player.x + player.width > p.x && player.y + player.height <= p.y + 10 && player.y + player.height + player.velY >= p.y) { player.velY = 0; player.y = p.y - player.height; player.grounded = true; } });
    player.x += player.velX; player.y += player.velY; if (player.x < 0) player.x = 0;
    coins.forEach(c => { if (!c.collected && checkCollision(player, c)) { c.collected = true; score += 10; } });
    enemies.forEach(e => { if (!e.alive) return; e.x += e.speed; if (e.x < 0 || e.x > 770) e.speed = -e.speed; if (checkCollision(player, e)) { if (player.velY > 0 && player.y + player.height - player.velY <= e.y + 10) { e.alive = false; player.velY = -player.jumpForce * 0.7; score += 50; } else { gameOver = true; } } });
}
function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    platforms.forEach(p => { ctx.fillStyle = p.color; ctx.fillRect(p.x, p.y, p.width, p.height); ctx.strokeStyle = '#000'; ctx.strokeRect(p.x, p.y, p.width, p.height); });
    coins.forEach(c => { if (!c.collected) { ctx.fillStyle = '#fcc419'; ctx.beginPath(); ctx.arc(c.x + c.width/2, c.y + c.height/2, c.width/2, 0, Math.PI * 2); ctx.fill(); } });
    enemies.forEach(e => { if (e.alive) { ctx.fillStyle = e.color; ctx.fillRect(e.x, e.y, e.width, e.height); ctx.fillStyle = '#fff'; ctx.fillRect(e.x + 5, e.y + 5, 5, 5); ctx.fillRect(e.x + 20, e.y + 5, 5, 5); } });
    ctx.fillStyle = player.color; ctx.fillRect(player.x, player.y, player.width, player.height);
    ctx.fillStyle = '#a80000'; ctx.fillRect(player.x - 2, player.y, player.width + 4, 8);
    ctx.fillStyle = '#fff'; ctx.font = '20px Arial'; ctx.fillText('النقاط: ' + score, 20, 30);
    if (gameOver) { ctx.fillStyle = 'rgba(0, 0, 0, 0.7)'; ctx.fillRect(0, 0, canvas.width, canvas.height); ctx.fillStyle = '#ff3333'; ctx.font = '40px Arial'; ctx.fillText('Game Over', canvas.width / 2 - 100, canvas.height / 2); }
}
function gameLoop() { update(); draw(); requestAnimationFrame(gameLoop); }
gameLoop();
</script>
</body>
</html>
